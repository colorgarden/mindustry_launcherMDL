<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MindustryLauncher.Pages.SchematicsPage"
             Style="{StaticResource PageStyle}"
             Title="Schematics">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="12,16,12,0">

        <!-- Source selector -->
        <Frame Grid.Row="0" Style="{StaticResource CardFrame}" Padding="12">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button x:Name="SourceMinriBtn"
                        Text="MinRi2 Archive"
                        Style="{StaticResource PrimaryButton}"
                        FontSize="13"
                        HeightRequest="36"
                        Grid.Column="0"
                        Clicked="OnSelectMinri" />
                <Button x:Name="SourceDesignitBtn"
                        Text="DesignIt"
                        Style="{StaticResource OutlinedButton}"
                        FontSize="13"
                        HeightRequest="36"
                        Grid.Column="1"
                        Clicked="OnSelectDesignit" />
            </Grid>
        </Frame>

        <!-- Search -->
        <Entry x:Name="SearchEntry"
               Grid.Row="1"
               Placeholder="Search schematics..."
               Style="{StaticResource SearchEntry}"
               TextChanged="OnSearchTextChanged" />

        <!-- Schematic list -->
        <CollectionView x:Name="SchematicList"
                        Grid.Row="2"
                        SelectionMode="Single">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Style="{StaticResource CardFrame}" Margin="0,0,0,8">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                                <Label Text="{Binding UI_Name}"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource OnSurface}" />
                                <Label Text="{Binding UI_Description}"
                                       FontSize="12"
                                       TextColor="{StaticResource Outline}"
                                       MaxLines="2"
                                       LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1"
                                    Text="GET"
                                    Style="{StaticResource PrimaryButton}"
                                    FontSize="12"
                                    HeightRequest="32"
                                    Padding="14,0"
                                    VerticalOptions="Center"
                                    Clicked="OnDownload" />
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="32" HorizontalOptions="Center" VerticalOptions="Center">
                    <Label x:Name="SchematicEmptyLabel"
                           Text="Fetch a source first"
                           FontSize="14"
                           TextColor="{StaticResource Outline}"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
        </CollectionView>

        <!-- Loading -->
        <ActivityIndicator x:Name="LoadingIndicator"
                           Grid.Row="2"
                           IsRunning="False"
                           IsVisible="False"
                           Color="{StaticResource Primary}"
                           HeightRequest="48"
                           WidthRequest="48"
                           VerticalOptions="Center"
                           HorizontalOptions="Center" />

        <!-- Status -->
        <Label x:Name="StatusLabel"
               Grid.Row="3"
               Text=""
               FontSize="12"
               TextColor="{StaticResource Outline}"
               HorizontalOptions="Center"
               Margin="0,8,0,8" />
    </Grid>
</ContentPage>
