<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Material Design 3 palette — Blue primary -->
    <Color x:Key="Primary">#1372CE</Color>
    <Color x:Key="OnPrimary">#FFFFFF</Color>
    <Color x:Key="PrimaryContainer">#D7E3FF</Color>
    <Color x:Key="OnPrimaryContainer">#001B3E</Color>

    <Color x:Key="Secondary">#535F70</Color>
    <Color x:Key="OnSecondary">#FFFFFF</Color>
    <Color x:Key="SecondaryContainer">#D7E3FF</Color>
    <Color x:Key="OnSecondaryContainer">#101C2B</Color>

    <Color x:Key="Tertiary">#6C5E7B</Color>
    <Color x:Key="OnTertiary">#FFFFFF</Color>

    <Color x:Key="Error">#BA1A1A</Color>
    <Color x:Key="OnError">#FFFFFF</Color>

    <!-- Surface colors -->
    <Color x:Key="Surface">#FEFBFF</Color>
    <Color x:Key="OnSurface">#1B1B1F</Color>
    <Color x:Key="SurfaceVariant">#E0E2EC</Color>
    <Color x:Key="OnSurfaceVariant">#44474E</Color>
    <Color x:Key="SurfaceContainer">#F0EDF4</Color>

    <Color x:Key="Outline">#74777F</Color>
    <Color x:Key="OutlineVariant">#C4C6D0</Color>

    <!-- Semantic -->
    <Color x:Key="CardBackground">#FFFFFF</Color>
    <Color x:Key="PageBackground">#F5F5F5</Color>
    <Color x:Key="SuccessGreen">#2E7D32</Color>
    <Color x:Key="WarningOrange">#F57F17</Color>

</ResourceDictionary>
